+// ArkTS reports "Need object" when a bridged function is called without a valid
+// receiver, so a failed call always leaves a pending exception behind that has to be
+// consumed before the next napi call.
+inline void clearPendingException(napi_env env, const std::string &context)
+{
+    bool pending = false;
+    if (napi_is_exception_pending(env, &pending) != napi_ok || !pending)
+        return;
+
+    napi_value exception = nullptr;
+    if (napi_get_and_clear_last_exception(env, &exception) != napi_ok || !exception) {
+        qOhosPrintfWarning("%s: cleared a pending JS exception (%s)", Q_FUNC_INFO, context.c_str());
+        return;
+    }
+
+    napi_value asString = nullptr;
+    if (napi_coerce_to_string(env, exception, &asString) != napi_ok || !asString) {
+        qOhosPrintfWarning("%s: cleared a pending JS exception (%s)", Q_FUNC_INFO, context.c_str());
+        return;
+    }
+
+    std::string message;
+    size_t length = 0;
+    if (napi_get_value_string_utf8(env, asString, nullptr, 0, &length) == napi_ok) {
+        message.resize(length + 1);
+        if (napi_get_value_string_utf8(env, asString, message.data(), message.size(), &length)
+            == napi_ok) {
+            message.resize(length);
+        } else {
+            message.clear();
+        }
+    }
+    qOhosPrintfWarning("%s: JS exception while probing (%s): %s", Q_FUNC_INFO,
+                       context.c_str(), message.c_str());
+}
