+inline std::string toLower(std::string text)
+{
+    std::transform(text.begin(), text.end(), text.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return text;
+}
+
+inline bool nameMatches(const std::string &name, const char *needle)
+{
+    return toLower(name).find(toLower(needle)) != std::string::npos;
+}
+
+struct EnumeratedHit
+{
+    QNapi::Function maker;
+    QNapi::Object makerReceiver;
+    QNapi::Object instance;
+    std::string propName;
+    std::string how;
+
+    bool isValid() const { return !maker.IsEmpty() || !instance.IsEmpty(); }
+};
+
+inline bool callableReturnsObject(napi_env env, napi_value receiver, napi_value function,
+                                 const std::string &label)
+{
+    napi_value result = nullptr;
+    if (napi_call_function(env, receiver, function, 0, nullptr, &result) != napi_ok) {
+        clearPendingException(env, label);
+        return false;
+    }
+    if (!result) {
+        qOhosPrintfDebug("%s: '%s()' produced no value", Q_FUNC_INFO, label.c_str());
+        return false;
+    }
+
+    napi_valuetype type = napi_undefined;
+    if (napi_typeof(env, result, &type) != napi_ok) {
+        clearPendingException(env, label);
+        return false;
+    }
+    if (type != napi_object) {
+        qOhosPrintfDebug("%s: '%s()' returned a non-object (napi_typeof=%d)", Q_FUNC_INFO,
+                         label.c_str(), static_cast<int>(type));
+        return false;
+    }
+    return true;
+}
+
+inline bool objectOffersLocalStorageApi(const QNapi::Object &object)
+{
+    try {
+        return object.Has("setOrCreate") || (object.Has("set") && object.Has("get"));
+    } catch (const std::exception &e) {
+        qOhosPrintfDebug("%s: probing a nested object threw: %s", Q_FUNC_INFO, e.what());
+        return false;
+    }
+}
+
+inline EnumeratedHit findByEnumeration(napi_env env, const QNapi::Object &object,
+                                       const std::string &source)
+{
+    EnumeratedHit hit;
+
+    const std::vector<std::string> names = enumeratePropertyNames(env, object);
+    qOhosPrintfDebug("%s: '%s' exposes %zu propert(ies): %s", Q_FUNC_INFO, source.c_str(),
+                     names.size(), describePropertyNames(names).c_str());
+
+    // 1) callables that may produce a LocalStorage, best name first. A callable that
+    //    needs a receiver is retried with the global object and, as a last resort,
+    //    through napi_new_instance().
+    static const char *const makerNameHints[] = {
+        "makeNewLocalStorage", "invoke", "call", "apply", "factory", "constructor"
+    };
+    for (const char *hint : makerNameHints) {
+        for (const std::string &name : names) {
+            if (!nameMatches(name, hint))
+                continue;
+
+            napi_value rawFunction = nullptr;
+            if (napi_get_named_property(env, object, name.c_str(), &rawFunction) != napi_ok
+                || !rawFunction) {
+                clearPendingException(env, name);
+                continue;
+            }
+
+            napi_valuetype type = napi_undefined;
+            if (napi_typeof(env, rawFunction, &type) != napi_ok) {
+                clearPendingException(env, name);
+                continue;
+            }
+            if (type != napi_function) {
+                qOhosPrintfDebug("%s: '%s.%s' is not napi_function (napi_typeof=%d)", Q_FUNC_INFO,
+                                 source.c_str(), name.c_str(), static_cast<int>(type));
+                continue;
+            }
+
+            auto function = QNapi::Function(env, rawFunction);
+            if (callableReturnsObject(env, object, rawFunction, name + "(this=owner)")) {
+                hit.maker = function;
+                hit.makerReceiver = object;
+                hit.propName = name;
+                hit.how = "call(this=owner)";
+                return hit;
+            }
+
+            napi_value global = nullptr;
+            if (napi_get_global(env, &global) == napi_ok && global
+                && callableReturnsObject(env, global, rawFunction, name + "(this=global)")) {
+                hit.maker = function;
+                hit.makerReceiver = QNapi::Object(env, global);
+                hit.propName = name;
+                hit.how = "call(this=global)";
+                return hit;
+            }
+
+            napi_value constructed = nullptr;
+            if (napi_new_instance(env, rawFunction, 0, nullptr, &constructed) != napi_ok
+                || !constructed) {
+                clearPendingException(env, name + "(new)");
+                continue;
+            }
+
+            auto constructedObject = QNapi::Object(env, constructed);
+            if (objectOffersLocalStorageApi(constructedObject)) {
+                hit.instance = constructedObject;
+                hit.propName = name;
+                hit.how = "new";
+                return hit;
+            }
+        }
+    }
+
+    // 2) nested objects one level deep that look like a LocalStorage or like the
+    //    module interface object Qt's ArkTS template returns.
+    for (const std::string &name : names) {
+        if (name == "constructor" || name == "__proto__")
+            continue;
+
+        napi_value rawChild = nullptr;
+        if (napi_get_named_property(env, object, name.c_str(), &rawChild) != napi_ok || !rawChild) {
+            clearPendingException(env, name);
+            continue;
+        }
+
+        napi_valuetype type = napi_undefined;
+        if (napi_typeof(env, rawChild, &type) != napi_ok) {
+            clearPendingException(env, name);
+            continue;
+        }
+        if (type != napi_object)
+            continue;
+
+        auto child = QNapi::Object(env, rawChild);
+        try {
+            auto nestedMaker
+                = QNapi::getOptionalPropOrEmpty<QNapi::Function>(child, "makeNewLocalStorage");
+            if (!nestedMaker.IsEmpty()) {
+                hit.maker = nestedMaker;
+                hit.makerReceiver = child;
+                hit.propName = name + ".makeNewLocalStorage";
+                hit.how = "nested";
+                return hit;
+            }
+        } catch (const std::exception &e) {
+            qOhosPrintfDebug("%s: nested probe of '%s.%s' threw: %s", Q_FUNC_INFO, source.c_str(),
+                             name.c_str(), e.what());
+        }
+
+        if (objectOffersLocalStorageApi(child)) {
+            hit.instance = child;
+            hit.propName = name;
+            hit.how = "nested";
+            return hit;
+        }
+    }
+
+    return hit;
+}
