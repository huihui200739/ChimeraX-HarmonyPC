+inline std::vector<std::string> enumeratePropertyNames(napi_env env, const QNapi::Object &object)
+{
+    std::vector<std::string> names;
+    napi_value rawNames = nullptr;
+
+    // own + inherited, including non-enumerable ones: ArkTS hides bridge members in
+    // every one of those buckets depending on the compiled form.
+    napi_status status = napi_get_all_property_names(
+        env, object, napi_key_include_prototypes, napi_key_all_properties,
+        napi_key_numbers_to_strings, &rawNames);
+    if (status != napi_ok || !rawNames) {
+        clearPendingException(env, "napi_get_all_property_names");
+        rawNames = nullptr;
+        status = napi_get_property_names(env, object, &rawNames);
+        if (status != napi_ok || !rawNames) {
+            clearPendingException(env, "napi_get_property_names");
+            return names;
+        }
+    }
+
+    uint32_t length = 0;
+    if (napi_get_array_length(env, rawNames, &length) != napi_ok)
+        return names;
+
+    names.reserve(length);
+    for (uint32_t i = 0; i < length; ++i) {
+        napi_value element = nullptr;
+        if (napi_get_element(env, rawNames, i, &element) != napi_ok || !element)
+            continue;
+
+        // Array indices/number keys are reported as numbers, so coerce first.
+        napi_value elementAsString = nullptr;
+        if (napi_coerce_to_string(env, element, &elementAsString) != napi_ok || !elementAsString) {
+            clearPendingException(env, "napi_coerce_to_string");
+            continue;
+        }
+
+        std::string name;
+        size_t elementLength = 0;
+        if (napi_get_value_string_utf8(env, elementAsString, nullptr, 0, &elementLength)
+            != napi_ok) {
+            continue;
+        }
+        name.resize(elementLength + 1);
+        if (napi_get_value_string_utf8(env, elementAsString, name.data(), name.size(),
+                                       &elementLength) != napi_ok) {
+            continue;
+        }
+        name.resize(elementLength);
+        if (!name.empty())
+            names.push_back(std::move(name));
+    }
+
+    return names;
+}
+
+inline std::string describePropertyNames(const std::vector<std::string> &names,
+                                         std::size_t maxNames = 10)
+{
+    if (names.empty())
+        return "<none>";
+
+    std::string result;
+    for (std::size_t i = 0; i < names.size() && i < maxNames; ++i) {
+        if (!result.empty())
+            result += ',';
+        result += names[i];
+    }
+    if (names.size() > maxNames)
+        result += ",...";
+    return result;
+}
