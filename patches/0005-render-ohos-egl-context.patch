+# --- EGL / GLES context for OpenHarmony ----------------------------------
+# Python-side context used instead of the Qt QOpenGLContext.  It follows the
+# same duck-typed interface as OffScreenRenderingContext above so that Render
+# and Framebuffer work unchanged.
+class EGLContext:
+    '''OpenGL ES context built on EGL, for platforms without Qt (OHOS).
+
+    Two modes:
+      * adopt the EGL context the application already made current for the
+        XComponent surface (no native code change needed, draws on screen);
+      * create a private pbuffer context when nothing is current (offscreen).
+    '''
+
+    required_opengl_version = (3, 0)     # GLES 3.0 is the OHOS baseline
+    required_opengl_core_profile = False
+
+    def __init__(self, graphics_window = None, screen = None, use_stereo = False):
+        _initialize_pyopengl()          # sets the global GL module (EGL platform)
+
+        import os
+        self.window = graphics_window
+        self._screen = screen
+        self._mode = 'mono'             # no stereo on OHOS
+        self._color_bits = None
+        self._depth_bits = 24
+        self._framebuffer_color_bits = 8
+        self._wait_for_vsync = True
+        self._deleted = False
+        self._owns_context = False
+        self._width = int(os.environ.get('CHIMERAX_OHOS_OFFSCREEN_WIDTH', 512))
+        self._height = int(os.environ.get('CHIMERAX_OHOS_OFFSCREEN_HEIGHT', 512))
+        self._pixel_scale = float(os.environ.get('CHIMERAX_PIXEL_SCALE', 1.0))
+
+        from weakref import WeakSet
+        self._framebuffers = WeakSet()
+        self._bindings = WeakSet()
+
+        from OpenGL import EGL
+        self._EGL = EGL
+        self.display = EGL.EGL_NO_DISPLAY
+        self.surface = EGL.EGL_NO_SURFACE
+        self.context = EGL.EGL_NO_CONTEXT
+        self.config = None
+        self.current_shader_program = None
+        self.current_viewport = None
+        self.default_draw_target = GL.GL_BACK
+
+    # -- creation ---------------------------------------------------------
+    def _egl_available(self):
+        from OpenGL import EGL
+        return EGL is not None
+
+    def _create(self):
+        from OpenGL import EGL
+        if self._egl_available() and EGL.eglGetCurrentContext():
+            # The app (native gl_surface.cpp) already made its context current
+            # on this thread; adopt it instead of building a second one.
+            self.display = EGL.eglGetCurrentDisplay()
+            self.context = EGL.eglGetCurrentContext()
+            self.surface = EGL.eglGetCurrentSurface(EGL.EGL_DRAW)
+            self._owns_context = False
+            return
+        self._create_pbuffer()
+
+    def _create_pbuffer(self):
+        from OpenGL import EGL
+        E = EGL
+        self.display = E.eglGetDisplay(E.EGL_DEFAULT_DISPLAY)
+        if not self.display:
+            raise OpenGLError('EGL: no display (CLI process without a HarmonyOS surface?)')
+        major = (EGL.EGLint * 1)()
+        minor = (EGL.EGLint * 1)()
+        if not E.eglInitialize(self.display, major, minor):
+            raise OpenGLError('EGL: eglInitialize failed (0x%x)' % E.eglGetError())
+
+        attribs = [E.EGL_SURFACE_TYPE, E.EGL_PBUFFER_BIT,
+                   E.EGL_RENDERABLE_TYPE, E.EGL_OPENGL_ES3_BIT,
+                   E.EGL_RED_SIZE, 8, E.EGL_GREEN_SIZE, 8,
+                   E.EGL_BLUE_SIZE, 8, E.EGL_ALPHA_SIZE, 8,
+                   E.EGL_DEPTH_SIZE, 24,
+                   E.EGL_NONE]
+        configs = (E.EGLConfig * 1)()
+        n = (EGL.EGLint * 1)()
+        if not E.eglChooseConfig(self.display, (EGL.EGLint * len(attribs))(*attribs),
+                                 configs, 1, n) or n[0] < 1:
+            raise OpenGLError('EGL: no ES3 pbuffer config (0x%x)' % E.eglGetError())
+        self.config = configs[0]
+
+        pattrs = [E.EGL_WIDTH, self._width, E.EGL_HEIGHT, self._height, E.EGL_NONE]
+        self.surface = E.eglCreatePbufferSurface(
+            self.display, self.config, (EGL.EGLint * len(pattrs))(*pattrs))
+        if not self.surface:
+            raise OpenGLError('EGL: eglCreatePbufferSurface failed (0x%x)' % E.eglGetError())
+
+        # Ask for ES 3.2 first (Mali-G77 / Maleoon provide it), fall back to 3.0.
+        for minor_version in (2, 1, 0):
+            cattrs = [E.EGL_CONTEXT_MAJOR_VERSION, 3,
+                      E.EGL_CONTEXT_MINOR_VERSION, minor_version, E.EGL_NONE]
+            ctx = E.eglCreateContext(self.display, self.config, E.EGL_NO_CONTEXT,
+                                     (EGL.EGLint * len(cattrs))(*cattrs))
+            if ctx:
+                self.context = ctx
+                break
+        if not self.context:
+            cattrs = [E.EGL_CONTEXT_CLIENT_VERSION, 3, E.EGL_NONE]
+            self.context = E.eglCreateContext(self.display, self.config, E.EGL_NO_CONTEXT,
+                                              (EGL.EGLint * len(cattrs))(*cattrs))
+        if not self.context:
+            raise OpenGLError('EGL: eglCreateContext(ES3) failed (0x%x)' % E.eglGetError())
+        self._owns_context = True
+        self.make_current()
+
+    # -- state ------------------------------------------------------------
+    @property
+    def created(self):
+        return bool(self.context)
+
+    def make_current(self, window = None):
+        if self._deleted:
+            return False
+        if not self.created:
+            self._create()
+            return True
+        E = self._EGL
+        if E.eglGetCurrentContext() == self.context:
+            self._bind_target_once()
+            return True
+        if not E.eglMakeCurrent(self.display, self.surface, self.surface, self.context):
+            raise OpenGLError('EGL: eglMakeCurrent failed (0x%x)' % E.eglGetError())
+        self._bind_target_once()
+        return True
+
+    def _bind_target_once(self):
+        # GLES has no core/compat VAO story like desktop GL but ChimeraX needs a
+        # bound VAO before shader attribute binding, which Render.initialize_opengl
+        # creates.  Nothing to do here; kept as an extension point.
+        pass
+
+    def done_current(self):
+        if self._deleted or not self.created:
+            return
+        self._EGL.eglMakeCurrent(self.display, self._EGL.EGL_NO_SURFACE,
+                                 self._EGL.EGL_NO_SURFACE, self._EGL.EGL_NO_CONTEXT)
+
+    def swap_buffers(self, window = None):
+        if self.surface and self.display:
+            self._EGL.eglSwapBuffers(self.display, self.surface)
+
+    def swap_interval(self):
+        return 0
+
+    def wait_for_vsync(self, wait):
+        # No portable EGL swap interval control on OHOS.
+        self._wait_for_vsync = wait
+        return False
+
+    def pixel_scale(self):
+        return self._pixel_scale
+
+    @property
+    def stereo(self):
+        return False
+
+    def enable_stereo(self, stereo, window):
+        # Sequential stereo is not available through EGL/GLES on OHOS.
+        return not stereo
+
+    def set_offscreen_color_bits(self, bits):
+        if bits != self._framebuffer_color_bits:
+            self._framebuffer_color_bits = bits
+            self.make_current()
+            for fb in tuple(self._framebuffers):
+                fb.set_color_bits(bits)
+            self.done_current()
+
+    def delete(self):
+        if self._deleted:
+            return
+        self._deleted = True
+        E = self._EGL
+        try:
+            self.done_current()
+            if self._owns_context:
+                if self.surface:
+                    E.eglDestroySurface(self.display, self.surface)
+                if self.context:
+                    E.eglDestroyContext(self.display, self.context)
+            self.surface = E.EGL_NO_SURFACE
+            self.context = E.EGL_NO_CONTEXT
+        except Exception:
+            pass
+
+    def __del__(self):
+        if not self._deleted:
+            self.delete()
+
+
+def _egl_remember_current():
+    from OpenGL import EGL
+    ctx = EGL.eglGetCurrentContext()
+    surf = EGL.eglGetCurrentSurface(EGL.EGL_DRAW)
+    return (ctx or None, surf)
+
+
+def _egl_restore_current(remembered_context):
+    from OpenGL import EGL
+    ctx, surf = remembered_context
+    if ctx and EGL.eglGetCurrentContext() != ctx:
+        EGL.eglMakeCurrent(EGL.eglGetCurrentDisplay(), surf, surf, ctx)
+
+
+_GLSL_ES_REPLACEMENTS = (
+    ('precision highp float;\n', ''),
+)
+
+
+def translate_shader_to_gles(shader, original = None):
+    '''Rewrite the upstream "#version 330 core" GLSL into GLSL ES.
+
+    The upstream shader templates are desktop core-profile 3.30.  GLES has no
+    core profile flags and requires a precision qualifier in the fragment
+    shader, so the version line is replaced and the qualifier injected.
+    '''
+    version = ohos_glsl_version()
+    out = shader
+    for old in ('#version 330 core', '#version 330', '#version 320 core'):
+        if old in out:
+            out = out.replace(old, '#version ' + version, 1)
+            break
+    if 'precision' not in out:
+        eol = out.find('\n')
+        # first non-#define, non-empty line after the version line
+        lines = out.split('\n')
+        for i, line in enumerate(lines):
+            ls = line.strip()
+            if i == 0 or not ls or ls.startswith('#define'):
+                continue
+            lines.insert(i, 'precision highp float;\nprecision highp int;\nprecision highp sampler2D;')
+            eol = None
+            out = '\n'.join(lines)
+            break
+    return out
+
+
+# OHOS has no Qt QOpenGLContext: hand out the EGL implementation instead.
+# Everything in ChimeraX imports OpenGLContext lazily (inside functions), so
+# rebinding the module attribute is enough and keeps the diff small.
+if running_on_ohos():
+    OpenGLContext = EGLContext
