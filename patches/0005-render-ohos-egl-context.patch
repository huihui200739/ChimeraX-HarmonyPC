+# --- OpenHarmony (OHOS) support ------------------------------------------
+# OHOS builds use the EGL/GLES platform: there is no Qt QOpenGLContext and no
+# GLX/CGL.  The whole graphics stack therefore runs either on the EGL context
+# the HarmonyOS app already made current for the XComponent surface, or on a
+# private pbuffer context created from Python.  See
+# docs/render-integration-2026-11-18.md.
+_ohos_state = {'probed': False, 'running': False}
+
+def running_on_ohos():
+    '''True when running on OpenHarmony/HarmonyOS (EGL + GLES only).'''
+    st = _ohos_state
+    if not st['probed']:
+        st['probed'] = True
+        st['running'] = _detect_ohos()
+    return st['running']
+
+def _detect_ohos():
+    import os, sys
+    # Explicit override wins: also lets the host test the ohos code paths.
+    if os.environ.get('CHIMERAX_OHOS') == '1':
+        return True
+    if sys.platform.startswith('ohos'):
+        return True
+    if not sys.platform.startswith('linux') or os.environ.get('CHIMERAX_OHOS') == '0':
+        return False
+    # A private aarch64-linux-ohos CPython reports sys.platform == 'linux', so
+    # look for the OHOS userland fingerprint.
+    try:
+        import platform
+        ident = ('%s %s' % (platform.platform(), platform.machine())).lower()
+    except Exception:
+        return False
+    if 'ohos' in ident or 'openharmony' in ident or 'harmony' in ident:
+        return True
+    # OHOS userland lives under /system with libEGL.so and no glibc ldconfig.
+    return os.path.isdir('/system/lib64') and os.path.exists('/system/lib64/libEGL.so')
+
+def ohos_glsl_version():
+    '''GLSL ES version line used when translating the upstream #version 330 shaders.'''
+    import os
+    return os.environ.get('CHIMERAX_OHOS_GLSL_VERSION', '300 es')
+
+def _pin_ohos_egl_libraries():
+    '''Load libEGL/libGLESv3 globally so PyOpenGL's EGL platform can resolve symbols.
 
+    PyOpenGL's ctypesloader looks for "libEGL.so" through the dynamic loader; on
+    OHOS the libraries are in /system/lib64 and only reachable through
+    LD_LIBRARY_PATH, which is why the app may want to pin them explicitly with
+    CHIMERAX_OHOS_EGL_SO / CHIMERAX_OHOS_GLES_SO.
+    '''
+    import ctypes, os
+    for env, names in (('CHIMERAX_OHOS_EGL_SO', ('libEGL.so', 'libEGL.so.1')),
+                       ('CHIMERAX_OHOS_GLES_SO', ('libGLESv3.so', 'libGLESv2.so'))):
+        candidates = []
+        pinned = os.environ.get(env)
+        if pinned:
+            candidates.append(pinned)
+        candidates.extend('/system/lib64/' + n for n in names)
+        candidates.extend(names)
+        for c in candidates:
+            try:
+                ctypes.CDLL(c, mode=ctypes.RTLD_GLOBAL)
+                break
+            except OSError:
+                continue
+
 # OpenGL workarounds:
